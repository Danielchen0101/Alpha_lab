# The initial Lightsail deployment is deliberately passive. Keep this true
# until the Render scheduler has been disabled and the cutover is approved.
ALPHALAB_DISABLE_BACKGROUND_SERVICES=true

FLASK_ENV=production
FLASK_DEBUG=false
DEBUG_ENDPOINTS=false
PIPELINE_AUTO_FILE_FALLBACK=false
SUPABASE_URL=https://nwpxjqgqegxttucsmvmp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
FERNET_KEY=
APP_SECRET_KEY=
FRONTEND_ORIGIN=https://www.alphalabquant.com

# Public browser build configuration. These values are embedded in the React
# bundle; they are not backend secrets. Replace the placeholders on the host.
REACT_APP_SITE_URL=https://www.alphalabquant.com
REACT_APP_SUPABASE_URL=https://nwpxjqgqegxttucsmvmp.supabase.co
REACT_APP_SUPABASE_ANON_KEY=replace-with-public-anon-key
REACT_APP_TURNSTILE_SITE_KEY=replace-with-public-site-key

BACKEND_PLAN_MEMORY_MB=4096
BACKEND_MEMORY_SOFT_LIMIT_MB=3000
BACKEND_MEMORY_ABORT_LIMIT_MB=3400
MARKET_SCAN_MAX_CONCURRENT=2
MARKET_SCAN_HEADLESS_WAIT_SECONDS=600
MALLOC_ARENA_MAX=2

CRYPTO_LIVE_RELEASE_ADMITTED=false
CRYPTO_SCHEDULER_WORKERS=2
